        y = torch.empty_like(x_contig)
        n_elements = x_contig.numel()
        grid = (triton.cdiv(n_elements, 1024),)
        _abs_sub_kernel[grid](x_contig, y, n_elements, BLOCK_SIZE=1024, num_warps=4)
